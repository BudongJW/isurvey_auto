# 패널파워(https://www.panel.co.kr) 로그인 정보
# 비워 두면 `python -m src.main login` 실행 시 터미널에서 묻는다 (--headed 면 브라우저에 직접 입력).
PANEL_ID=your_panel_id
PANEL_PW=your_panel_password

# (선택) 브라우저 창 없이 실행할지 여부. 기본 true
# HEADLESS=true

# (선택) 로그인 세션(토큰) 저장 위치와 조회 결과 저장 폴더
# STATE_PATH=.auth/state.json
# DATA_DIR=data

# (선택) `playwright install chromium` 대신 이미 설치된 Chromium/Chrome 을 쓸 때 실행 파일 경로
# CHROMIUM_PATH=/usr/bin/chromium
